{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the code-rs main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:default"
  ],
  "remote": {
    "urls": [
      "http://vscode-app.localhost/*",
      "vscode-app://localhost/*"
    ]
  }
}
